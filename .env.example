# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# CallMeBot WhatsApp Configuration
# 1. Add CallMeBot phone number to your contacts: +34 644 44 49 53 (or as indicated on callmebot.com)
# 2. Send WhatsApp message: "I allow callmebot to send me messages" to the bot.
# 3. You will receive your API key instantly.
CALLMEBOT_PHONE=+918985897700
CALLMEBOT_API_KEY=your_callmebot_api_key_here
